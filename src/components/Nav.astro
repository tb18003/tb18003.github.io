---
import Icon from './Icon.astro';
import { homeUrl, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const links = [
  { href: '#about', label: t('nav.about') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#teams', label: t('nav.orgs') },
  { href: '#legacy', label: t('nav.deprecated') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors" data-nav>
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Main">
    <a href={homeUrl[lang]} class="group flex items-center gap-2 font-mono text-sm font-semibold">
      <span
        class="grid size-8 place-items-center rounded-lg bg-accent text-on-accent transition-transform group-hover:-rotate-6"
        aria-hidden="true">tb</span
      >
      <span class="hidden sm:inline">tb18003</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="rounded-full px-3 py-1.5 text-sm text-muted transition-colors hover:bg-surface-2 hover:text-text"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5">
      <a
        href={homeUrl[other]}
        hreflang={other}
        lang={other}
        class="rounded-full border border-line px-3 py-1.5 font-mono text-xs font-medium text-muted uppercase transition-colors hover:text-text"
        aria-label={other === 'en' ? 'Read in English' : 'Leer en español'}
      >
        {other}
      </a>
      <button
        type="button"
        class="grid size-9 place-items-center rounded-full border border-line text-muted transition-colors hover:text-text"
        aria-label={t('nav.theme')}
        data-theme-toggle
      >
        <Icon name="sun" size={16} class="hidden dark:block" />
        <Icon name="moon" size={16} class="block dark:hidden" />
      </button>
      <button
        type="button"
        class="grid size-9 place-items-center rounded-full border border-line text-muted md:hidden"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" size={16} class="menu-open" />
        <Icon name="close" size={16} class="menu-close hidden" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg/95 backdrop-blur-xl md:hidden" data-menu>
    <ul class="container-page flex flex-col py-3">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-xl px-3 py-3 text-base text-muted hover:bg-surface-2 hover:text-text">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    header.classList.toggle('bg-bg/80', scrolled);
    header.classList.toggle('backdrop-blur-xl', scrolled);
    header.classList.toggle('border-line', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const setMenu = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.querySelector('.menu-open')?.classList.toggle('hidden', open);
    menuBtn.querySelector('.menu-close')?.classList.toggle('hidden', !open);
    if (open) header.classList.add('bg-bg/80', 'backdrop-blur-xl');
    else if (window.scrollY <= 8) header.classList.remove('bg-bg/80', 'backdrop-blur-xl');
  };
  menuBtn.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
</script>
